def busqueda_binaria_por_id(lista, id_buscado):
    """
    Busca una película por ID usando búsqueda binaria.
    REQUISITO: Las películas DEBEN estar ordenadas por 'id' ANTES de llamar.
    Complejidad: O(log n)
    """
    inicio = 0
    fin = len(lista) - 1
    
    while inicio <= fin:
        medio = (inicio + fin) // 2
        
        # Validación de tipo (por si acaso el ID no es numérico)
        try:
            id_medio = int(lista[medio]['id'])
        except (ValueError, TypeError):
            # En un caso real, esto indicaría un problema en los datos
            return None, None 
            
        if id_medio == id_buscado:
            return medio, lista[medio]
        
        elif id_medio < id_buscado:
            inicio = medio + 1
        else:
            fin = medio - 1
    
    return None, None


def busqueda_secuencial_por_titulo(lista, titulo_parcial):
    """
    Busca películas por título usando búsqueda secuencial PARCIAL.
    Complejidad: O(n)
    """
    resultados = []
    titulo_parcial = titulo_parcial.lower().strip()
    
    for i in range(len(lista)):
        titulo_pelicula = lista[i]['titulo'].lower()
        
        # Búsqueda parcial: verifica si el texto está contenido en el título
        if titulo_parcial in titulo_pelicula:
            resultados.append((i, lista[i]))
    
    return resultados


def generar_reporte_rating(lista):
    """
    Genera un reporte de películas ordenadas por rating (mayor a menor).
    Usa el Bubble Sort genérico.
    """
    # Ordenar por rating usando Bubble Sort genérico, en modo descendente (Mayor a Menor)
    peliculas_ordenadas = bubble_sort(lista, 'rating', descendente=True)
    
    # Generar reporte
    print("\n" + "="*70)
    print(" "*15 + "REPORTE DE PELÍCULAS POR RATING")
    print(" "*16 + "(Ordenadas con Bubble Sort)")
    print(" "*20 + "(Mayor a Menor)")
    print("="*70)
    
    for i, pelicula in enumerate(peliculas_ordenadas, 1):
        print(f"\n#{i}")
        print(f"   Título:    {pelicula['titulo']}")
        print(f"   Año:       {pelicula['ano']}")
        print(f"   Director:  {pelicula['director']}")
        print(f"   Rating:    {pelicula['rating']}/10")
        print("-"*70)
    
    print("\n" + "="*70)
    print(f"Total de películas: {len(peliculas_ordenadas)}")
    print("="*70 + "\n")


