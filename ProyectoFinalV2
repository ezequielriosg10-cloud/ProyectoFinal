def main():
    # Cargar películas iniciales
    archivo_actual = "peliculas.json"
    
    try:
        peliculas = leer_peliculas(archivo_actual)
        print(f"[OK] {len(peliculas)} peliculas cargadas desde '{archivo_actual}'")
    except FileNotFoundError:
        print(f"[ERROR] No se encontro el archivo '{archivo_actual}'")
        return

    # ==========================================================
    # CORRECCIÓN CRÍTICA: Ordenar por ID al inicio para la Búsqueda Binaria O(log n)
    # Usamos QuickSort (O(n log n) promedio) para este ordenamiento inicial eficiente.
    # QuickSort modifica la lista 'peliculas' in-place.
    # ==========================================================
    try:
        quick_sort(peliculas, 'id', 0, len(peliculas) - 1) 
        print(f"[AVISO] Lista ordenada por ID con QuickSort para Búsqueda Binaria.")
    except Exception as e:
        print(f"[ERROR] Falló el ordenamiento inicial por ID: {e}")
        return


    while True:
        menu_principal()
        opcion = input("\nSeleccione una opcion: ").strip()

        if opcion == "1":
            # BÚSQUEDA POR ID (Ya ordenada)
            try:
                id_buscado = int(input("\nIngrese el ID de la pelicula: "))
                posicion, pelicula = busqueda_binaria_por_id(peliculas, id_buscado)
                
                if pelicula:
                    imprimir_resultado_busqueda_id(posicion, pelicula)
                else:
                    print(f"\n[X] No se encontro ninguna pelicula con ID {id_buscado}\n")
            except ValueError:
                print("\n[ERROR] El ID debe ser un numero entero\n")

        elif opcion == "2":
            # BÚSQUEDA POR TÍTULO
            titulo = input("\nIngrese el titulo (o parte del titulo): ").strip()
            if titulo:
                resultados = busqueda_secuencial_por_titulo(peliculas, titulo)
                imprimir_resultados_busqueda_titulo(resultados)
            else:
                print("\n[ERROR] Debe ingresar un titulo\n")

        elif opcion == "3":
            # REPORTE POR RATING
            generar_reporte_rating(peliculas)
            
        elif opcion == "4":
            # ANÁLISIS EMPÍRICO
            analisis_empirico()

        elif opcion == "5":
            # CAMBIAR ARCHIVO DE DATOS
            nuevo_archivo = cambiar_archivo_datos()
            
            if nuevo_archivo:
                try:
                    peliculas = leer_peliculas(nuevo_archivo)
                    archivo_actual = nuevo_archivo
                    # ¡IMPORTANTE! Reordenar la nueva lista para Búsqueda Binaria
                    quick_sort(peliculas, 'id', 0, len(peliculas) - 1) 
                    print(f"\n[OK] {len(peliculas)} peliculas cargadas y ordenadas desde '{archivo_actual}'\n")
                except FileNotFoundError:
                    print(f"\n[ERROR] No se encontro el archivo '{nuevo_archivo}'")
                    print(f"  Manteniendo archivo actual: '{archivo_actual}'\n")
                except Exception as e:
                    print(f"[ERROR] Falló el procesamiento del nuevo archivo: {e}")

        elif opcion == "6":
            # SALIR
            print("\n[OK] Saliendo del programa...\n")
            break

        else:
            print("\n[ERROR] Opcion no valida. Intente de nuevo.\n")


if __name__ == "__main__":
    main()
