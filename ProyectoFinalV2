def analisis_empirico():
    print("\n" + "="*80)
    print("ANÁLISIS EMPÍRICO – BÚSQUEDA SECUENCIAL (O(n)) Y BUBBLE SORT (O(n²))")
    print("="*80)

    archivos = {
        50: "peliculas_50.json",
        200: "peliculas_200.json",
        500: "peliculas_500.json",
        1000: "peliculas_1000.json"
    }

    tamaños = list(archivos.keys())

    tiempos = {
        'busqueda_secuencial': [], # CLAVE CORREGIDA
        'bubble_sort': []          # CLAVE CORREGIDA
    }

    memorias = {
        'busqueda_secuencial': [], # CLAVE CORREGIDA
        'bubble_sort': []          # CLAVE CORREGIDA
    }

    for n in tamaños:
        print(f"Procesando tamaño n = {n}...")
        peliculas = leer_peliculas(archivos[n])
        
        # Opcional: Para la medición de ordenamiento, es buena práctica trabajar 
        # con una copia desordenada para medir el peor o caso promedio de O(n²)
        copia_desordenada = peliculas.copy() 

        # Búsqueda Secuencial O(n)
        t_s, mem, _ = medir_tiempo_memoria(
            busqueda_secuencial_por_titulo,
            peliculas,
            "the"
        )
        tiempos['busqueda_secuencial'].append(t_s)
        memorias['busqueda_secuencial'].append(mem)

        # Bubble Sort O(n²)
        t_s, mem, _ = medir_tiempo_memoria(
            bubble_sort,
            copia_desordenada, # Usamos la copia para asegurar medición limpia
            'rating',
            True # Orden descendente, como en el reporte
        )
        tiempos['bubble_sort'].append(t_s)
        memorias['bubble_sort'].append(mem)

    print("\nAnálisis finalizado. Generando gráfica...\n")
    generar_graficas_interactivas(tamaños, tiempos, memorias)


