def leer_peliculas(nombre_archivo):
    """Lee las películas desde un archivo JSON"""
    with open(nombre_archivo, "r", encoding="utf-8") as archivo:
        peliculas = json.load(archivo)
    return peliculas

def bubble_sort(lista, campo, descendente=False):
    """
    Algoritmo Bubble Sort genérico para ordenar por cualquier campo.
    Acepta un parámetro 'descendente' para cambiar la dirección.
    Complejidad: O(n²)
    """
    n = len(lista)
    # Crear copia para no modificar original si es llamada para el reporte
    lista_copia = lista.copy() 
    
    for i in range(n - 1): 
        for j in range(n - i - 1):
            if descendente:
                # Orden descendente (Mayor a Menor)
                if lista_copia[j][campo] < lista_copia[j + 1][campo]:
                    lista_copia[j], lista_copia[j + 1] = lista_copia[j + 1], lista_copia[j]
            else:
                # Orden ascendente (Menor a Mayor) por defecto
                if lista_copia[j][campo] > lista_copia[j + 1][campo]:
                    lista_copia[j], lista_copia[j + 1] = lista_copia[j + 1], lista_copia[j]
    return lista_copia # Retorna la copia ordenada

def quick_sort(lista, campo, inicio, fin):
    """
    Algoritmo Quick Sort genérico para ordenar por cualquier campo.
    Ordena In-place (modifica la lista original).
    Complejidad: O(n log n) promedio
    """
    if inicio >= fin:
        return
    
    # Función auxiliar de partición (Lomuto o Hoare, aquí Hoare-like simple)
    def particion(lista, campo, inicio, fin):
        pivote = lista[fin][campo]
        i = inicio - 1
        for j in range(inicio, fin):
            if lista[j][campo] <= pivote:
                i = i + 1
                lista[i], lista[j] = lista[j], lista[i]
        lista[i + 1], lista[fin] = lista[fin], lista[i + 1]
        return i + 1

    pos = particion(lista, campo, inicio, fin)
    quick_sort(lista, campo, inicio, pos - 1)
    quick_sort(lista, campo, pos + 1, fin)

